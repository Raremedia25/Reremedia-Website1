# ------------------------------------------------------------------
# Raremedia platform — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
#
# NOTE: `next build` copies .env into the server bundle that is deployed
# (Next.js standalone behaviour), and Netlify's own site variables override
# it at runtime. Keep machine-only secrets (SEED_ADMIN_*, NETLIFY_API_TOKEN)
# in .env.local instead: it is read by the seed scripts but never bundled.
# ------------------------------------------------------------------

# Database (Prisma, PostgreSQL).
# On Netlify nothing is needed: Netlify Database injects NETLIFY_DB_URL in
# builds, functions and `netlify dev` (which starts a local PostgreSQL).
# Set DATABASE_URL only when running outside `netlify dev` (e.g. `npm run dev`
# or `npm run db:seed` from a plain terminal): copy the local database URL from
# `netlify database status --show-credentials`, or use any PostgreSQL server.
DATABASE_URL="postgresql://user:password@localhost:5432/raremedia"

# Secret used to sign admin session cookies. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the website (used for sitemap, canonical URLs, Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First Super Admin account created by `npm run db:seed`.
SEED_ADMIN_NAME="Raremedia Admin"
SEED_ADMIN_EMAIL="admin@raremedia.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Media storage. "local" writes to UPLOADS_DIR and serves via /uploads/*.
# "netlify-blobs" stores files in Netlify Blobs (production; when seeding
# from your machine also set NETLIFY_SITE_ID and NETLIFY_API_TOKEN).
# "cloudinary" uploads to Cloudinary (set the CLOUDINARY_* values).
STORAGE_PROVIDER="local"
NETLIFY_SITE_ID=""
NETLIFY_API_TOKEN=""
UPLOADS_DIR="./storage/uploads"
MAX_UPLOAD_MB="10"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="raremedia"

# Email notifications (optional). When SMTP is not configured, notifications
# are logged to the server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Raremedia <no-reply@raremedia.com>"
NOTIFY_EMAIL="isaie.rare@gmail.com"
