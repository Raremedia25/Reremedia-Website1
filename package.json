{
  "name": "raremedia-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Raremedia company website, portfolio, CMS, image gallery, project request platform and admin dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migration": "node scripts/db-migration.mjs",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx prisma/seed.ts",
    "db:seed:prod": "node scripts/seed-production.mjs",
    "db:studio": "prisma studio",
    "setup": "npm run db:push && npm run db:seed"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "@netlify/database": "^2.0.1",
    "@prisma/client": "^6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "marked": "^18.1.0",
    "next": "^16.4.0",
    "nodemailer": "^10.0.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/nodemailer": "^7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.0",
    "prisma": "^6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
