// Raremedia platform — database schema
//
// PostgreSQL (Netlify Database in production, `netlify dev` locally). Schema
// changes ship as SQL files in netlify/database/migrations, generated from this
// file with `npm run db:migration -- <slug>` (never `db push` against Netlify).
// The schema avoids database-specific types (enums/JSON) so it also works on
// SQLite for quick offline experiments (provider = "sqlite", DATABASE_URL="file:./dev.db"):
// enum-like fields are validated strings (see src/lib/constants.ts) and list
// fields are JSON-encoded strings (see src/lib/json.ts).

generator client {
  provider      = "prisma-client-js"
  // "native" for local builds, rhel-openssl-3.0.x for Netlify Functions (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("VIEWER") // SUPER_ADMIN | CONTENT_MANAGER | PROJECT_MANAGER | VIEWER
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects  Project[]
  posts     Post[]
  media     Media[]
  auditLogs AuditLog[]

  @@index([role])
}

// ------------------------------------------------------------ taxonomy

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String
  type        String   @default("project") // project | post
  description String?
  color       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]
  posts    Post[]

  @@unique([slug, type])
  @@index([type, order])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  icon        String   @default("code")
  summary     String
  description String?
  items       String   @default("[]") // JSON string[]
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

// --------------------------------------------------------------- media

model Media {
  id           String   @id @default(cuid())
  provider     String   @default("local")
  storageKey   String
  url          String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String   @default("")
  caption      String   @default("")
  folder       String   @default("general")
  variants     String   @default("[]") // JSON MediaVariant[]
  blurDataUrl  String?
  isDemo       Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy        User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  projectImages     ProjectImage[]
  postImages        PostImage[]
  featuredProjects  Project[]        @relation("ProjectFeaturedImage")
  featuredPosts     Post[]           @relation("PostFeaturedImage")
  requestAttachments ProjectRequest[]
  testimonials      Testimonial[]

  @@index([folder, createdAt])
}

// ------------------------------------------------------------ projects

model Project {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  summary         String
  content         String    @default("")
  categoryId      String?
  projectStatus   String    @default("COMPLETED") // PLANNED | IN_PROGRESS | COMPLETED | RESEARCH
  publishStatus   String    @default("DRAFT")     // DRAFT | PUBLISHED | SCHEDULED
  publishedAt     DateTime?
  scheduledAt     DateTime?
  clientType      String?
  completedAt     DateTime?
  demoUrl         String?
  githubUrl       String?
  features        String    @default("[]") // JSON string[]
  technologies    String    @default("[]") // JSON string[]
  featuredImageId String?
  isFeatured      Boolean   @default(false)
  order           Int       @default(0)
  views           Int       @default(0)
  seoTitle        String?
  seoDescription  String?
  authorId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage Media?         @relation("ProjectFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  images        ProjectImage[]
  testimonials  Testimonial[]

  @@index([publishStatus, publishedAt])
  @@index([categoryId])
  @@index([isFeatured, order])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  mediaId   String
  order     Int      @default(0)
  caption   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId])
  @@index([projectId, order])
}

// --------------------------------------------------------------- posts

model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String    @default("")
  type            String    @default("ARTICLE") // ARTICLE | UPDATE | ANNOUNCEMENT | TUTORIAL | CASE_STUDY | NEWS | PROMOTION
  categoryId      String?
  tags            String    @default("[]") // JSON string[]
  featuredImageId String?
  authorId        String?
  publishStatus   String    @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  publishedAt     DateTime?
  scheduledAt     DateTime?
  views           Int       @default(0)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage Media?      @relation("PostFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  author        User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  images        PostImage[]

  @@index([publishStatus, publishedAt])
  @@index([categoryId])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  mediaId   String
  order     Int      @default(0)
  caption   String?
  createdAt DateTime @default(now())

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([postId, order])
}

// ------------------------------------------------------------- inbound

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW") // NEW | READ | REPLIED | ARCHIVED
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model ProjectRequest {
  id             String   @id @default(cuid())
  fullName       String
  company        String?
  email          String
  phone          String
  projectType    String
  budgetRange    String?
  description    String
  features       String?
  deadline       String?
  referenceLinks String?
  attachmentId   String?
  status         String   @default("NEW") // NEW | REVIEWING | QUOTED | ACCEPTED | DECLINED | ARCHIVED
  adminNotes     String?
  ip             String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  attachment Media? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// --------------------------------------------------------------- system

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, createdAt])
  @@index([userId, createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------- testimonials

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String?
  company     String?
  quote       String
  rating      Int      @default(5)
  photoId     String?
  projectId   String?
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photo   Media?   @relation(fields: [photoId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([isPublished, order])
}
